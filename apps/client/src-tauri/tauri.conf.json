{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixGram",
  "version": "0.1.0",
  "identifier": "ru.madfrog.matrixgram",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MatrixGram", "width": 1280, "height": 820, "minWidth": 360, "minHeight": 550 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Matrix-клиент без E2EE",
    "windows": { "nsis": { "languages": ["Russian", "English"], "displayLanguageSelector": true } }
  }
}
