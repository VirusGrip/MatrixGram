{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixGram",
  "version": "0.5.3",
  "identifier": "ru.madfrog.matrixgram",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MatrixGram",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 550,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Matrix-клиент с папками и необязательным E2EE",
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREOThDN0M3NjUzMTJDRUEKUldUcUxERmx4OGVZM1RBZENCMjhGTTBOQWlUeDZQUm9WRmtPZ0pJNDhjekZpT3MrS1hSNkhPWVcK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/VirusGrip/MatrixGram/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
