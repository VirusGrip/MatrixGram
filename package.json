{
  "name": "matrixgram",
  "version": "0.5.2",
  "private": true,
  "workspaces": [
    "apps/client"
  ],
  "scripts": {
    "dev": "npm run dev -w @matrixgram/client",
    "build": "npm run build -w @matrixgram/client",
    "test": "npm run test -w @matrixgram/client",
    "test:e2e": "npm run test:e2e -w @matrixgram/client",
    "tauri": "npm run tauri -w @matrixgram/client --",
    "check:policy": "node scripts/check-policy.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "test:load": "npm exec -w @matrixgram/client -- playwright test --config playwright.load.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
